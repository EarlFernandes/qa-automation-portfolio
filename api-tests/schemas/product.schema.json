{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product.schema.json",
  "title": "Product",
  "type": "object",
  "required": ["id", "title", "description", "category", "price", "rating", "stock", "thumbnail", "images"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string", "minLength": 1 },
    "price": { "type": "number", "minimum": 0 },
    "discountPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "rating": { "type": "number", "minimum": 0, "maximum": 5 },
    "stock": { "type": "integer", "minimum": 0 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "brand": { "type": "string" },
    "sku": { "type": "string" },
    "weight": { "type": "number" },
    "dimensions": {
      "type": "object",
      "required": ["width", "height", "depth"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "depth": { "type": "number" }
      }
    },
    "warrantyInformation": { "type": "string" },
    "shippingInformation": { "type": "string" },
    "availabilityStatus": { "type": "string" },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rating", "comment", "date", "reviewerName"],
        "properties": {
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "comment": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "reviewerName": { "type": "string" },
          "reviewerEmail": { "type": "string" }
        }
      }
    },
    "returnPolicy": { "type": "string" },
    "minimumOrderQuantity": { "type": "integer", "minimum": 1 },
    "thumbnail": { "type": "string", "format": "uri" },
    "images": { "type": "array", "items": { "type": "string", "format": "uri" } }
  }
}
