# Copy this file to .env and fill in the keys you have. .env is ignored by git.
# Shell variables and CI secrets take priority over this file.

# Anthropic: create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI: create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional default model for the chosen provider, for example claude-haiku-4-5 or gpt-4o-mini
LLM_MODEL=
